# CIFAR-100 端到端短流程检查，不用于报告精度。
PYTHON_BIN=${PYTHON_BIN:-python}
CUDA_DEVICE=0
DATASET=cifar100
DATA_ROOT=${DATA_ROOT:-data}
MODEL=resnet18
DEVICE=cuda
WORKERS=0
PIN_MEMORY=0
SEED=0

TARGET_RELUS=
KEEP_RATIO=0.50
EXPERIMENT_NAME=smoke_resnet18_relu_0.50
OUTPUT_ROOT=outputs/smoke
LOG_ROOT=logs/smoke
SKIP_COMPLETED_STAGES=0

MOMENTUM=0.9
WEIGHT_DECAY=5e-4
LR_MILESTONES=150,180,210
LR_DECAY=0.1
KD_TEMPERATURE=4

TEACHER_EPOCHS=1
TEACHER_BATCH_SIZE=2
TEACHER_LR=0.05
TEACHER_MAX_TRAIN_BATCHES=1

PRUNER_EPOCHS=1
PRUNER_BATCH_SIZE=2
PRUNER_LR=0.05
PRUNER_GAMMA=0.5
PRUNER_ALPHA=0.5
PRUNER_WARMUP_EPOCHS=0
PRUNER_TARGET_EPOCH_RATIO=0
PRUNER_UPDATE_INTERVAL=1
PRUNER_MAX_TRAIN_BATCHES=2
INIT_FROM_TEACHER=0

FINETUNE_EPOCHS=1
FINETUNE_BATCH_SIZE=2
FINETUNE_LR=0.01
FINETUNE_GAMMA=0.5
FINETUNE_ALPHA=0.5
FINETUNE_BETA=1000
FINETUNE_MAX_TRAIN_BATCHES=1

EVAL_BATCH_SIZE=2
MAX_VAL_BATCHES=1
