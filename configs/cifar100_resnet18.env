# Environment
PYTHON_BIN=/home/zhenpengl/anaconda3/envs/relupruner/bin/python
CUDA_DEVICE=0

# Dataset and model
DATASET=cifar100
DATA_ROOT=/home/zhenpengl/research-data/datasets
MODEL=resnet18
DEVICE=cuda
WORKERS=4
PIN_MEMORY=0
SEED=0

# Experiment identity and output
TARGET_RELUS=
KEEP_RATIO=0.10
EXPERIMENT_NAME=resnet18_relu_0.10
OUTPUT_ROOT=outputs
LOG_ROOT=logs
SKIP_COMPLETED_STAGES=1

# Shared optimizer settings
MOMENTUM=0.9
WEIGHT_DECAY=5e-4
LR_MILESTONES=150,180,210
LR_DECAY=0.1
KD_TEMPERATURE=4

# Dense teacher
TEACHER_EPOCHS=240
TEACHER_BATCH_SIZE=128
TEACHER_LR=0.05

# Taylor pruning stage
PRUNER_EPOCHS=150
PRUNER_BATCH_SIZE=128
PRUNER_LR=0.05
PRUNER_GAMMA=0.5
PRUNER_ALPHA=0.5
PRUNER_WARMUP_EPOCHS=5
PRUNER_TARGET_EPOCH_RATIO=0.6
PRUNER_UPDATE_INTERVAL=100
INIT_FROM_TEACHER=0

# Fixed-mask finetuning stage
FINETUNE_EPOCHS=240
FINETUNE_BATCH_SIZE=128
FINETUNE_LR=0.01
FINETUNE_GAMMA=0.5
FINETUNE_ALPHA=0.5
FINETUNE_BETA=1000

# Evaluation
EVAL_BATCH_SIZE=128

# Leave these empty for full training. Set small integers only for smoke tests.
TEACHER_MAX_TRAIN_BATCHES=
PRUNER_MAX_TRAIN_BATCHES=
FINETUNE_MAX_TRAIN_BATCHES=
MAX_VAL_BATCHES=
